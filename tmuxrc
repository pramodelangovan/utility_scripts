##### Prefix & basic ergonomics #####
# Set prefix key to Ctrl-a (optional; default is Ctrl-b)
set -g prefix C-a
unbind C-b
bind C-a send-prefix

# Mouse support
set -g mouse on

# Terminal & history
set -g default-terminal "screen-256color"
set -g history-limit 10000
set -g mode-keys vi

# Splits with | and -
bind | split-window -h
bind - split-window -v
unbind '"'
unbind %

# Reload config quickly
bind r source-file ~/.tmux.conf \; display-message "Config reloaded!"

# Status bar minimal
set -g status-bg black
set -g status-fg white
set -g status-left "[#S]"
set -g status-right "%Y-%m-%d %H:%M"

##### Optional: key binding to create the 2x2 layout in any window #####
# Press Prefix + 4 to convert the current window into a 2x2 grid
bind 4 run-shell "tmux select-pane -t 0; tmux kill-pane -a; \
  tmux split-window -h; \
  tmux select-pane -t 0; tmux split-window -v; \
  tmux select-pane -t 1; tmux split-window -v; \
  tmux select-layout tiled"

bind h run-shell "tmux select-pane -t 0; tmux kill-pane -a; tmux split-window -h;"

bind v run-shell "tmux select-pane -t 0; tmux kill-pane -a; tmux split-window -v;"

bind s run-shell "tmux select-pane -t 0; tmux kill-pane -a;"

#copy to system clipboard (Linux)
set-option -g set-clipboard on

# Use xclip for external copy
bind -T copy-mode-vi y send -X copy-pipe-and-cancel "xclip -selection clipboard -in"

bind c copy-mode

